# Copy this file to .env and fill only the providers you intend to use.
# Never commit .env. Never paste real secrets into source files.

ACTIVE_LLM_PROVIDER=hybrid_um_first

# University of Macau GenAI / Open WebUI
OPEN_WEBUI_BASE_URL=https://chat.genai.um.edu.mo/api
OPEN_WEBUI_API_KEY=
OPEN_WEBUI_TEXT_MODEL=deepseek-v4.1-flash-1017
OPEN_WEBUI_FAST_MODEL=GLM-Flash-5.3
OPEN_WEBUI_OCR_MODEL=GLM-OCR

# Direct DeepSeek fallback
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_VISION_MODEL=deepseek-v4.1-flash-1017

# OpenAI-compatible fallback
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6.1-terra

# Local Ollama fallback
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:14b

# Study rules
VISION_PROVIDER=hybrid_vision
USE_FREE_LOCAL_MATH_OCR=true
SECTION_MASTERY_THRESHOLD=0.80
WRONG_QUESTION_GRADUATION_STREAK=3
MIDTERM_FINAL_DURATION_MINUTES=120
PHOTO_UPLOAD_GRACE_MINUTES=5

# Optional campus SSO recovery. Keep these local and private.
UMPASS_USERNAME=
UMPASS_PASSWORD=
